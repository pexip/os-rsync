+relative_link = SCRATCHDIR / 'relative-home'
+os.symlink(str(real), absolute_link)
+os.symlink(str(real), relative_link)
+
+cases = (
+    (('-r',), False),
+    (('-rR',), True),
+    (('-rR', '--no-inc-recursive'), True),
+)
