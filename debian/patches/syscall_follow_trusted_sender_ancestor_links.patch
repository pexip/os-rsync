+#!/usr/bin/env python3
+"""Explicit source directory symlinks remain transfer roots."""
+
+import os
+import pwd
+import subprocess
+
+from rsyncfns import SCRATCHDIR, rsync_argv, test_fail
+
+real = SCRATCHDIR / 'real'
+source = real / 'My_Documents'
